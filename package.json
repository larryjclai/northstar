{
  "name": "northstar",
  "version": "0.1.0-alpha.56",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/inject-private-assets.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check:tauri": "cd src-tauri && cargo fmt --check && cargo check",
    "tauri": "tauri",
    "version": "node scripts/version-bump.mjs",
    "copy:export": "node scripts/copy-catalog.mjs export",
    "copy:import": "node scripts/copy-catalog.mjs import",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "license:check": "license-checker --production --excludePrivatePackages --excludePackagesStartingWith \"northstar\" --failOn \"GPL-2.0;GPL-3.0;LGPL-2.0;LGPL-2.1;LGPL-3.0;AGPL-3.0;SSPL-1.0\""
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@ibm/plex-sans-tc": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.80.6",
    "@tanstack/react-router": "^1.121.12",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-haptics": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.2.0",
    "@tauri-apps/plugin-stronghold": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "react-qr-code": "^2.0.21",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.52.0",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "license-checker": "^25.0.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "shadcn": "^4.8.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0",
