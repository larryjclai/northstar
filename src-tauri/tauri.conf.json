{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Northstar",
  "version": "0.1.0-alpha.23",
  "identifier": "app.northstar.finance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Northstar",
        "width": 1240,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "category": "Finance",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4M0E1NTYwNkZFMzg4ODAKUldTQWlPTnZZRlU2aUhOVzRkN1QxSVhqblZ0UUp3THZMNXhYTzh3V1JacXhGQ005MHJwQ09vVWcK",
      "endpoints": [
        "https://github.com/larryjclai/northstar-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
