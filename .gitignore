# ─── Build artifacts ───────────────────────────────────
# Both forms are required. `node_modules/` (trailing slash) matches a
# DIRECTORY only — it does not match a *symlink* named node_modules, which is
# how agent worktrees commonly share the main checkout's install. Without the
# slashless line, a `git add -A` in such a worktree commits the symlink, and
# the next checkout in the main repo replaces the real directory with a
# self-referential link (happened on 2026-07-26, plan 278).
node_modules
node_modules/
scratch/
dist/
dist-ssr/
.vite/
.cache/
coverage/
target/
src-tauri/target/
src-tauri/gen/schemas/

# The Tauri updater manifest. It's published as a release asset, not stored in
# the repo — release.yml's post-publish verification step downloads it into
# the checkout root, which is how a stray copy ends up here.
/latest.json

# ─── Tests ─────────────────────────────────────────────
test-results/
playwright-report/
playwright/.cache/

# ─── Privacy: local data ───────────────────────────────
# Tauri SQL plugin / dev SQLite / any local store
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.store
*.store-shm
*.store-wal

# Personal data exports / backups
backup/
backups/
*.bak

# Local design review uploads and screenshots. Review/redact before committing
# any images intentionally.
Design System/uploads/

# Private release-only assets. Official builds may copy these into public/
# before packaging, but they should not be published with the source repo.
private-assets/
public/bank/
public/etf-sector-feed.json
# Intermediate archive produced by scripts/pack-private-assets.sh (plan 249).
# The encrypted private-assets.tar.gz.enc IS committed; this plaintext tarball is not.
private-assets.tar.gz

# ─── Secrets ───────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.mobileprovision

# ─── Logs ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor / IDE ──────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.cursor/
.fleet/

# ─── Supabase local state ──────────────────────────────
supabase/.branches/
supabase/.temp/

# ─── Legacy Swift (paused, on wip/swift-pause branch) ──
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# ─── Installed Claude skills (impeccable) — local tooling, not app code ──
.claude/skills/
.github/skills/

# Local AI-agent tooling & private design history (kept locally, not published)
Design System/
.agents/
.impeccable/
.impeccable.md
skills-lock.json
.codex/

# Claude Code per-machine local settings (permission allowlist) — never publish
.claude/settings.local.json

# Executor worktrees — Tailwind v4 auto-source scanning respects .gitignore;
# unlisted, stale worktree copies leak dead utility classes into compiled CSS
.claude/worktrees/
