# Local release secrets for scripts/release-local.sh
# Copy this file to `.env` (which is gitignored) and fill in the real values.
# scripts/release-local.sh auto-sources `.env`, so a local macOS release will
# never prompt you for the signing-key password again.
#
# The signing PRIVATE KEY itself stays in ~/.tauri/northstar.key — the script
# reads it from there automatically. You only need to put the PASSWORD here.

# Password for ~/.tauri/northstar.key. Leave ="" only if the key has no password.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD="your-key-password"

# Optional: override the key file location (defaults to ~/.tauri/northstar.key).
# TAURI_SIGNING_KEY_PATH="$HOME/.tauri/northstar.key"

# Optional: a GitHub token with contents:write on larryjclai/northstar-releases.
# Only needed if `gh` is not already authenticated (gh auth login).
# GH_TOKEN=""

# Optional sync relay endpoint. Official releases may set this at build time.
# Leave empty for source builds that should keep sync disabled by default.
# VITE_NORTHSTAR_SYNC_WORKER_URL=""

# Optional private release assets directory. If it contains a `bank/` folder,
# scripts/inject-private-assets.mjs copies it into public/bank before build.
# NORTHSTAR_PRIVATE_ASSETS_DIR="private-assets"
