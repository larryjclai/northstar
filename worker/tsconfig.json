{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*"],
  // Tests run under vitest-pool-workers (its own transform + the cloudflare:test
  // ambient module); keep the production typecheck (`tsc --noEmit`, used by CI)
  // scoped to shipping source so test-only deps don't leak in.
  "exclude": ["**/*.test.ts", "test"]
}
